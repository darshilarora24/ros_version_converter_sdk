#!/usr/bin/env python3
import rclpy
from rclpy.node import Node


class MigratedNode(Node):
    def __init__(self) -> None:
        super().__init__('migrated_node')
        # TODO: declare publishers, subscriptions, and timers


def main(args=None) -> None:
    rclpy.init(args=args)
    node = MigratedNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info('Shutting down (keyboard interrupt).')
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()

